{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'purelane-best-combos.css' | asset_url }}">

<section class="pl-scope pl-sec" id="{{ section.settings.anchor | default: 'combos' }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i>
      </div>
      {%- if section.settings.subheading != blank -%}<p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- assign has_combo = false -%}
    <div class="pl-comborail pl-rv" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo' and block.settings.bundle_product != blank -%}
          {%- assign has_combo = true -%}
          {%- liquid
            assign bp = block.settings.bundle_product
            assign compare = bp.compare_at_price
            assign savings = 0
            if compare > bp.price
              assign savings = compare | minus: bp.price
            endif
          -%}
          <article class="pl-glass pl-combo" role="listitem" {{ block.shopify_attributes }}>
            <div class="pl-tray">
              {%- if savings > 0 -%}<span class="pl-save">{{ 'sections.combos.you_save' | t: default: 'You save' }} {{ savings | money }}</span>{%- endif -%}
              {%- if block.settings.flag_label != blank -%}<span class="pl-flag">{{ block.settings.flag_label }}</span>{%- endif -%}
              <div class="pl-stack">
                {%- for i in (1..3) -%}
                  {%- assign item_product_key = 'item_' | append: i | append: '_product' -%}
                  {%- assign item_benefit_key = 'item_' | append: i | append: '_benefit' -%}
                  {%- assign item_product = block.settings[item_product_key] -%}
                  {%- if item_product != blank -%}
                    {%- unless forloop.first -%}<span class="pl-plus" aria-hidden="true">+</span>{%- endunless -%}
                    <span class="pl-it">
                      {%- if item_product.featured_media -%}
                        {{ item_product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: item_product.title, class: 'pl-pimg' }}
                      {%- else -%}
                        <span class="pl-pimg pl-noimg" role="img" aria-label="{{ item_product.title | escape }}"></span>
                      {%- endif -%}
                      <span>{{ block.settings[item_benefit_key] | default: item_product.metafields.custom.benefit_tagline | default: item_product.title }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="pl-body">
              <h3>{{ bp.title }}</h3>
              <div class="pl-cnt">{{ block.settings.item_count_label | default: bp.title }}</div>
              {%- if block.settings.description != blank -%}<p class="pl-inc">{{ block.settings.description }}</p>{%- endif -%}
              <div class="pl-prow">
                <strong>{{ bp.price | money }}</strong>
                {%- if compare > bp.price -%}<s>{{ compare | money }}</s><em>{{ 'sections.combos.save' | t: default: 'Save' }} {{ savings | money }}</em>{%- endif -%}
              </div>
              <div class="pl-fine">{{ 'sections.combos.fine_print' | t: default: 'Inclusive of all taxes · COD available' }}</div>
              <a class="pl-btn {% if block.settings.flag_label != blank %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ bp.url }}">
                {{ 'sections.combos.shop_bundle' | t: default: 'Shop bundle' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- unless has_combo -%}
      <p class="pl-body-s">{{ 'sections.combos.empty' | t: default: 'Add a combo block and pick the bundle product it represents.' }}</p>
    {%- endunless -%}

    <div class="pl-swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      {{ 'sections.combos.swipe' | t: default: 'Swipe for more combos' }}
    </div>
  </div>
</section>

<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane Best Combos",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor ID", "default": "combos" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "Price, compare-at price and the buy link all come from this product." },
        { "type": "text", "id": "flag_label", "label": "Flag (e.g. \"Most popular\")" },
        { "type": "text", "id": "item_count_label", "label": "Item-count line", "default": "3 products" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "header", "content": "Item 1" },
        { "type": "product", "id": "item_1_product", "label": "Product" },
        { "type": "text", "id": "item_1_benefit", "label": "Benefit text", "info": "Falls back to the product's benefit_tagline metafield, then its title." },
        { "type": "header", "content": "Item 2" },
        { "type": "product", "id": "item_2_product", "label": "Product" },
        { "type": "text", "id": "item_2_benefit", "label": "Benefit text" },
        { "type": "header", "content": "Item 3 (optional)" },
        { "type": "product", "id": "item_3_product", "label": "Product" },
        { "type": "text", "id": "item_3_benefit", "label": "Benefit text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Purelane Best Combos", "blocks": [ { "type": "combo" }, { "type": "combo" } ] }
  ]
}
{% endschema %}
