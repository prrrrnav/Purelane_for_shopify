{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'purelane-hero.css' | asset_url }}">

<section class="pl-scope pl-hero" style="--pl-hero-bg-start:{{ section.settings.bg_start }};--pl-hero-bg-end:{{ section.settings.bg_end }};">
  <div class="pl-hero-grid pl-wrap">

    {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank or section.settings.badge_3 != blank -%}
    <div class="pl-badges pl-glass-2" aria-label="{{ 'sections.hero.promises' | t: default: 'Product promises' }}">
      {%- for i in (1..3) -%}
        {%- assign badge_text = 'badge_' | append: i | append: '_text' -%}
        {%- assign badge_icon = 'badge_' | append: i | append: '_icon' -%}
        {%- assign txt = section.settings[badge_text] -%}
        {%- if txt != blank -%}
        <div class="pl-badge">
          <span class="pl-bi">{% render 'purelane-icon', name: section.settings[badge_icon] %}</span>
          <span>{{ txt }}</span>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    <div class="pl-hero-copy">
      <h1 class="pl-d1 pl-rv pl-in">
        {{ section.settings.heading }}
      </h1>
      <div class="pl-rule pl-rv pl-rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede pl-rv pl-rv-d2">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="pl-hero-cta pl-rv pl-rv-d3">
        {%- if section.settings.primary_label != blank -%}
          <a class="pl-btn pl-btn-primary" href="{{ section.settings.primary_url | default: '#' }}">
            {{ section.settings.primary_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="pl-btn pl-btn-ghost" href="{{ section.settings.secondary_url | default: '#' }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
    <div class="pl-hero-prod" id="pl-heroProd-{{ section.id }}">
      <div class="pl-hstage" data-pl-hero-stage>
        {%- for block in section.blocks -%}
          {%- liquid
            assign first_product = block.settings.product_1
            assign second_product = block.settings.product_2
            assign third_product = block.settings.product_3
          -%}
          <div class="pl-hslide {% if forloop.first %}pl-on{% endif %}" {{ block.shopify_attributes }}>
            {%- for key in "product_1,product_2,product_3" | split: "," -%}
              {%- assign prod = block.settings[key] -%}
              {%- if prod != blank -%}
                {%- if prod.featured_media -%}
                  {{ prod.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', alt: prod.title, class: 'pl-hp' }}
                {%- else -%}
                  <div class="pl-hp pl-noimg" role="img" aria-label="{{ prod.title | escape }}"></div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if block.settings.price_label != blank -%}
              <div class="pl-glass-2 pl-ptag">
                <span class="pl-lbl">{{ block.settings.price_label }}</span>
                <span class="pl-val"><strong>{{ block.settings.price | times: 100 | money }}</strong>{% if block.settings.compare_price > block.settings.price %}<s>{{ block.settings.compare_price | times: 100 | money }}</s>{% endif %}</span>
                {%- if block.settings.cut_label != blank -%}<span class="pl-cut">{{ block.settings.cut_label }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
      <div class="pl-hdots" role="tablist" aria-label="{{ 'sections.hero.bundle_options' | t: default: 'Bundle options' }}">
        {%- for block in section.blocks -%}
          <button type="button" data-pl-hero-dot class="{% if forloop.first %}pl-on{% endif %}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ block.settings.price_label | default: block.settings.product_1.title }}"></button>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane Hero",
  "class": "pl-hero-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clean That Lasts" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Trust badges" },
    { "type": "text", "id": "badge_1_text", "label": "Badge 1 text", "default": "Plant powered" },
    { "type": "select", "id": "badge_1_icon", "label": "Badge 1 icon", "options": [ {"value":"leaf","label":"Leaf"}, {"value":"shield","label":"Shield"}, {"value":"spark","label":"Spark"} ], "default": "leaf" },
    { "type": "text", "id": "badge_2_text", "label": "Badge 2 text", "default": "Safe for kids & pets" },
    { "type": "select", "id": "badge_2_icon", "label": "Badge 2 icon", "options": [ {"value":"leaf","label":"Leaf"}, {"value":"shield","label":"Shield"}, {"value":"spark","label":"Spark"} ], "default": "shield" },
    { "type": "text", "id": "badge_3_text", "label": "Badge 3 text", "default": "Zero harsh chemicals" },
    { "type": "select", "id": "badge_3_icon", "label": "Badge 3 icon", "options": [ {"value":"leaf","label":"Leaf"}, {"value":"shield","label":"Shield"}, {"value":"spark","label":"Spark"} ], "default": "spark" },
    { "type": "color", "id": "bg_start", "label": "Background gradient start", "default": "#1ea38d" },
    { "type": "color", "id": "bg_end", "label": "Background gradient end", "default": "#01524e" }
  ],
  "blocks": [
    {
      "type": "bundle_slide",
      "name": "Bundle slide",
      "settings": [
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2 (optional)" },
        { "type": "product", "id": "product_3", "label": "Product 3 (optional)" },
        { "type": "text", "id": "price_label", "label": "Label", "default": "Single bottle" },
        { "type": "number", "id": "price", "label": "Price", "info": "Enter the whole-unit amount, e.g. 200 for ₹200.", "default": 200 },
        { "type": "number", "id": "compare_price", "label": "Compare-at price", "default": 299 },
        { "type": "text", "id": "cut_label", "label": "Savings label", "default": "33% off" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [ { "type": "bundle_slide" } ]
    }
  ]
}
{% endschema %}
