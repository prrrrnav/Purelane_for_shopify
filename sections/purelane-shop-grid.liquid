{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'purelane-shop-grid.css' | asset_url }}">

<section class="pl-scope pl-sec" id="{{ section.settings.anchor | default: 'shop' }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="pl-shelf">
      {%- liquid
        assign count = 0
        assign limit = section.settings.products_to_show
      -%}

      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: limit -%}
          {%- assign card_tag = blank -%}
          {%- if product.tags contains 'best-seller' -%}{%- assign card_tag = 'Best seller' -%}{%- endif -%}
          {%- if product.tags contains 'new' -%}{%- assign card_tag = 'New' -%}{%- endif -%}
          {%- capture reveal -%}pl-rv pl-rv-d{{ forloop.index0 | modulo: 3 | plus: 1 }}{%- endcapture -%}
          {%- render 'purelane-product-card', product: product, card_tag: card_tag, reveal_class: reveal -%}
          {%- assign count = count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Manual override / fill-in blocks, used when no collection is set or a merchant wants to pin specific products {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank and count < limit -%}
          {%- capture reveal -%}pl-rv pl-rv-d{{ count | modulo: 3 | plus: 1 }}{%- endcapture -%}
          {%- render 'purelane-product-card', product: block.settings.product, card_tag: block.settings.tag, reveal_class: reveal -%}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if count == 0 -%}
      <p class="pl-body-s">{{ 'sections.shop.no_products' | t: default: 'Select a collection or add products in the theme editor.' }}</p>
    {%- endif -%}

    {%- if section.settings.view_all_url != blank -%}
      <div style="text-align:center;margin-top:24px">
        <a class="pl-btn pl-btn-ghost" href="{{ section.settings.view_all_url }}">{{ section.settings.view_all_label | default: 'View all' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'purelane-sections.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor ID", "default": "shop" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "View all products" },
    { "type": "url", "id": "view_all_url", "label": "\"View all\" link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Pinned product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tag", "label": "Badge override", "info": "Leave blank to auto-detect Best seller / New / Sale / Sold out." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Purelane Shop Grid" }
  ]
}
{% endschema %}
